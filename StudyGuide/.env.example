# Copy to `.env` and edit. Docker Compose reads it automatically.

# Postgres credentials used by both the database and the API.
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=studyhub
POSTGRES_DB=studyhub

# Host ports. 8084 for the site, 5433 for Postgres, so neither collides with
# whatever else you run locally (npm run dev uses 8082).
WEB_PORT=8084
DB_PORT=5433

# Only needed when running outside Docker (`npm run dev`). Compose builds this
# for you; the hostname differs because Postgres is then local.
# DATABASE_URL=postgres://studyhub:studyhub@127.0.0.1:5433/studyhub

# Port for the standalone solutions API in development (Vite proxies /api here).
API_PORT=8090