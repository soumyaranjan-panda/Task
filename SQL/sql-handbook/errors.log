-- Q1: departments whose avg salary > company avg
WITH dept_avg AS (
  SELECT department_id, AVG(salary) AS avg_salary, COUNT(*) AS headcount
  FROM employees GROUP BY department_id
)
SELECT de.department_name, da.avg_salary, da.headcount
FROM dept_avg da JOIN departments de ON de.department_id = da.department_id
WHERE da.avg_salary > (SELECT AVG(salary) FROM employees);

-- Q2: top earner per dept
WITH ranked AS (
  SELECT employee_name, department_id, salary,
         ROW_NUMBER() OVER (PARTITION BY department_id ORDER BY salary DESC) AS rn
  FROM employees WHERE department_id IS NOT NULL
)
SELECT de.department_name, r.employee_name, r.salary
FROM ranked r JOIN departments de ON de.department_id = r.department_id
WHERE r.rn = 1;

-- Q3: running total
WITH cum AS (
  SELECT employee_name, salary,
         SUM(salary) OVER (ORDER BY employee_id) AS running_total
  FROM employees WHERE salary IS NOT NULL
)
SELECT employee_name, salary, running_total FROM cum ORDER BY employee_id;

-- Q4: order totals
WITH order_totals AS (
  SELECT o.order_id, o.customer_id, SUM(oi.qty * oi.unit_price) AS total
  FROM orders o JOIN order_items oi ON oi.order_id = o.order_id
  GROUP BY o.order_id, o.customer_id
)
SELECT ot.order_id, ot.customer_id, ot.total
FROM order_totals ot ORDER BY ot.order_id;

-- Q5: fan-out count trap
SELECT o.status, COUNT(*) AS rows_after_join
FROM orders o JOIN order_items oi ON oi.order_id = o.order_id
GROUP BY o.status ORDER BY o.status;

-- Q6: above dept avg
WITH stats AS (
  SELECT department_id, AVG(salary) AS dept_avg FROM employees
  WHERE department_id IS NOT NULL GROUP BY department_id
)
SELECT e.employee_name, e.salary, de.department_name
FROM employees e JOIN stats s ON s.department_id = e.department_id
JOIN departments de ON de.department_id = e.department_id
WHERE e.salary > s.dept_avg ORDER BY e.salary DESC;
